# Settings for `docker compose` (copy to .env). Every one has a default that suits
# a trial on this machine; change them to run it for real. See deploy/README.md.

# Where the app is published, and on which port. 127.0.0.1 means this machine only.
# Any other address makes it reachable by other people: then set ENVIRONMENT=production.
# WEB_BIND=127.0.0.1
# WEB_PORT=8080

# "development" is for trying it out: demo-friendly checks, and the first person to
# open the page can create the first (admin) account. "production" needs the three
# lines below and https in front.
# ENVIRONMENT=production

# Encrypts stored AI provider keys and two-step secrets. Make your own, and keep it
# somewhere safe: a restore needs the same one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# True once the app is served over https (the browser drops the cookie otherwise).
# COOKIE_SECURE=true

# The first account in production needs this code; if unset, one is printed in the
# backend's log (docker compose logs backend).
# SETUP_CODE=

# Load made-up demo records on first start. Turn off for real use.
# DEMO_DATA=false
