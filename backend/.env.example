DATABASE_URL=sqlite:///./ai_governance.db
EVIDENCE_STORAGE_DIR=./storage/evidence
CORS_ORIGINS=http://localhost:5173

# "development" relaxes the SECRET_KEY and COOKIE_SECURE checks below. Set
# it to "production" (or "staging") on a real deployment.
ENVIRONMENT=development

# False lets a fresh checkout run over http://localhost with no extra setup.
# A real deployment refuses to start on False -- set it to true, and serve
# the app over https (the browser drops a Secure cookie sent over plain
# http, so this only works once https is in place).
COOKIE_SECURE=false

# The first account on a real deployment needs a setup code. Leave this unset
# and the server prints one in its log each time it starts while no account
# exists; set it to choose your own. Not used in development.
# SETUP_CODE=

# Derives the key that encrypts stored AI provider credentials and two-step
# sign-in secrets, and signs the short-lived two-step sign-in tickets. The value
# below is public -- a real deployment refuses to start on it. Generate your own
# with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it makes those stored secrets unreadable: provider keys have to be
# re-entered, and people with two-step sign-in need a recovery code or a reset.
# Sessions are not affected (they are random tokens, stored hashed).
SECRET_KEY=change-me-in-a-real-deployment
